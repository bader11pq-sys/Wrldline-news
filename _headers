# Response headers for hosts that support a _headers file (Cloudflare Pages,
# Netlify). GitHub Pages ignores this file: the pages it serves only carry the
# document-level Referrer-Policy meta added by scripts/apply-security-meta.mjs.
# Article routes answer from the Cloudflare worker, which sends the same policy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: http: data: blob:; connect-src 'self' https://vmaxbnogmmfyrcucapnq.supabase.co; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'

/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800
