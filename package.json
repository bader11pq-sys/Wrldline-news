{
  "name": "worldline-news-ai-office",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "tsx worker/node.ts",
    "worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "release:service": "node --env-file=release-service/.env release-service/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "fast-xml-parser": "^5.3.8",
    "hono": "^4.11.10",
    "lucide-react": "^0.562.0",
    "parse5": "^7.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.180.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "wrangler": "4.73.0"
  }
}
